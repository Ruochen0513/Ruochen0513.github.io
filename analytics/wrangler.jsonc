{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salieri-visitors",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "routes": [
    { "pattern": "stats.salieri.site", "custom_domain": true }
  ],
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://salieri.site,https://www.salieri.site,https://ruochen0513.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salieri-visitors",
      "database_id": "d2c8d48a-e057-420b-a7f2-30ff31def0bd",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 0 * * *"] }
}
